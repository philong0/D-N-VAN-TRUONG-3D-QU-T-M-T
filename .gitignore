# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# python & ai-engine
venv/
**/venv/
__pycache__/
**/__pycache__/
*.pyc
*.so
*.dylib
*.dll
*.egg-info/
ai-engine/venv/
ai-engine/models/*.pth
ai-engine/models/*.onnx

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.tar.gz
*.zip
*.log
cloudflared

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local

# vercel
.vercel

# patient records & uploaded medical photos (local file-based storage)
/.data
.tmp*
.audit/
.backups/
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
